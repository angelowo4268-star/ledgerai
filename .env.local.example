# LedgerAI environment variables
# Copy this file to .env.local and fill in your values.

# OpenAI (invoice / chat / import AI features)
OPENAI_API_KEY=your_openai_api_key

# Google OAuth (Import Center -> Connect Google)
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# App URL used for OAuth redirect URI (recommended)
# Defaults to http://localhost:3000 when omitted in local development.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OAuth redirect URI to register in Google Cloud Console:
# ${NEXT_PUBLIC_APP_URL}/api/google/callback
#
# Example for local dev:
# http://localhost:3000/api/google/callback
