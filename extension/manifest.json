{
  "manifest_version": 3,
  "name": "LedgerAI",
  "version": "0.1.0",
  "description": "Import LINE Web chats into LedgerAI",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "LedgerAI",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab"],
  "host_permissions": [
    "*://*.line.me/*",
    "*://*.line.biz/*",
    "*://*.line-apps.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.line.me/*",
        "*://*.line.biz/*",
        "*://*.line-apps.com/*"
      ],
      "js": ["content/line-scraper.js"],
      "run_at": "document_idle"
    }
  ]
}
